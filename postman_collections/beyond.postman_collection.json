      "cookie" : [ ],
      "body" : "{\"_embedded\":{\"products\":[{\"_id\":\"73adce3d-bae7-4f70-b1f3-329fba1f1787\",\"sku\":\"vino020\",\"name\":\"Rødvin Rioja Castillo, år 2021\",\"manufacturer\":\"Grape Vineyard\",\"productIdentifiers\":[{\"type\":\"EAN\",\"value\":\"501234567890\"},{\"type\":\"UPC\",\"value\":\"425261\"}],\"salesPrice\":{\"amount\":8.7,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"listPrice\":{\"amount\":10.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"manufacturerPrice\":{\"amount\":11.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"refPrice\":{\"refQuantity\":1,\"unit\":\"LITER\",\"quantity\":0.75,\"price\":{\"amount\":11.6,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"}},\"shippingWeight\":{\"value\":1175.0,\"displayUnit\":\"GRAMS\"},\"shippingDimension\":{\"length\":1500,\"width\":1000,\"height\":2000},\"customText\":{\"label\":\"Tilføj modtagerens navn\",\"maxLength\":20},\"_embedded\":{\"defaultImage\":{\"dataUri\":\"https://yourshop.api.urn/storage-api/images/rioja-01.jpg?hash=e9a1ce5c0c6abfebec8fb1f6faf77dca7e6e7777{&width,height,upscale}\",\"width\":200,\"height\":300},\"availability\":{\"stockThreshold\":1,\"availableStock\":5,\"availabilityState\":\"IN_STOCK\",\"purchasable\":true}},\"productLabels\":[{\"type\":\"SALE\"},{\"type\":\"CUSTOMIZABLE\"}],\"type\":\"PRODUCT\",\"additionalDescriptions\":[{\"headline\":\"Om vingården\",\"htmlDescription\":\"<b>Drue-vingården</b><br>\\n<p>\\n  The Grape Vineyard er en af Spaniens mest berømte vingårde,\\n  især kendt for sin lækre rødvin.\\n  Selve vingården kan dateres tilbage til det 18. århundrede og\\n  og har været drevet af den samme familie i generationer.\\n</p>\\n\",\"_id\":\"7f79a09f-0416-432a-8bc7-1071618a61a4\"},{\"headline\":\"Om vinifikationen\",\"htmlDescription\":\"<p>\\n  At skabe denne lækre vin er en lang\\n  og delikat proces med mange trin.\\n</p>\\n<ol>\\n  <li>\\n    Druerne høstes, udvælges omhyggeligt,\\n    og forberedes til gæring.\\n  </li>\\n  <li>\\n    Efter gæringen lagres vinen i de fineste\\n    egetræskasser, som giver vinen dens unikke aroma.\\n  </li>\\n  <li>\\n    Efter at have gennemgået endnu en omhyggelig udvælgelsesproces,\\n    bliver vinen endelig tappet på flaske og er klar til at blive værdsat af vinelskere over hele verden.\\n  </li>\\n</ol>\\n\",\"_id\":\"26ed48e9-b8af-4ff2-8ddc-c9476d397104\"}],\"_links\":{\"self\":{\"href\":\"https://yourshop.api.urn/product-view/products/73adce3d-bae7-4f70-b1f3-329fba1f1787\"},\"product\":{\"href\":\"https://yourshop.api.urn/product-view/products/73adce3d-bae7-4f70-b1f3-329fba1f1787\"},\"cross-sells\":{\"href\":\"https://yourshop.api.urn/product-view/products/73adce3d-bae7-4f70-b1f3-329fba1f1787/cross-sells\"}},\"_indexedAt\":\"2026-06-15T08:06:29\"},{\"_id\":\"d52a296b-4a05-46ce-823a-5fbc7c000cbc\",\"sku\":\"vino020\",\"name\":\"Rødvin Rioja Castillo, år 2022\",\"manufacturer\":\"Grape Vineyard\",\"productIdentifiers\":[{\"type\":\"EAN\",\"value\":\"501234567890\"},{\"type\":\"UPC\",\"value\":\"425261\"}],\"salesPrice\":{\"amount\":8.7,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"listPrice\":{\"amount\":10.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"manufacturerPrice\":{\"amount\":11.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"refPrice\":{\"refQuantity\":1,\"unit\":\"LITER\",\"quantity\":0.75,\"price\":{\"amount\":11.6,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"}},\"shippingWeight\":{\"value\":1175.0,\"displayUnit\":\"GRAMS\"},\"shippingDimension\":{\"length\":1500,\"width\":1000,\"height\":2000},\"customText\":{\"label\":\"Tilføj modtagerens navn\",\"maxLength\":20},\"_embedded\":{\"defaultImage\":{\"dataUri\":\"https://yourshop.api.urn/storage-api/images/rioja-01.jpg?hash=e9a1ce5c0c6abfebec8fb1f6faf77dca7e6e7777{&width,height,upscale}\",\"width\":200,\"height\":300},\"availability\":{\"stockThreshold\":1,\"availableStock\":5,\"availabilityState\":\"IN_STOCK\",\"purchasable\":true}},\"productLabels\":[{\"type\":\"SALE\"},{\"type\":\"CUSTOMIZABLE\"}],\"type\":\"PRODUCT\",\"additionalDescriptions\":[{\"headline\":\"Om vingården\",\"htmlDescription\":\"<b>Drue-vingården</b><br>\\n<p>\\n  The Grape Vineyard er en af Spaniens mest berømte vingårde,\\n  især kendt for sin lækre rødvin.\\n  Selve vingården kan dateres tilbage til det 18. århundrede og\\n  og har været drevet af den samme familie i generationer.\\n</p>\\n\",\"_id\":\"2dbc26ba-094a-4c3e-85cb-f93c6897a044\"},{\"headline\":\"Om vinifikationen\",\"htmlDescription\":\"<p>\\n  At skabe denne lækre vin er en lang\\n  og delikat proces med mange trin.\\n</p>\\n<ol>\\n  <li>\\n    Druerne høstes, udvælges omhyggeligt,\\n    og forberedes til gæring.\\n  </li>\\n  <li>\\n    Efter gæringen lagres vinen i de fineste\\n    egetræskasser, som giver vinen dens unikke aroma.\\n  </li>\\n  <li>\\n    Efter at have gennemgået endnu en omhyggelig udvælgelsesproces,\\n    bliver vinen endelig tappet på flaske og er klar til at blive værdsat af vinelskere over hele verden.\\n  </li>\\n</ol>\\n\",\"_id\":\"7d774040-6781-431a-b050-8a582d9f4a2c\"}],\"_links\":{\"self\":{\"href\":\"https://yourshop.api.urn/product-view/products/d52a296b-4a05-46ce-823a-5fbc7c000cbc\"},\"product\":{\"href\":\"https://yourshop.api.urn/product-view/products/d52a296b-4a05-46ce-823a-5fbc7c000cbc\"},\"cross-sells\":{\"href\":\"https://yourshop.api.urn/product-view/products/d52a296b-4a05-46ce-823a-5fbc7c000cbc/cross-sells\"}},\"_indexedAt\":\"2026-06-15T08:06:29\"},{\"_id\":\"7f677638-6e2a-4a72-bab0-52aab5bc0903\",\"sku\":\"vino020\",\"name\":\"Rødvin Rioja Castillo, år 2023\",\"manufacturer\":\"Grape Vineyard\",\"productIdentifiers\":[{\"type\":\"EAN\",\"value\":\"501234567890\"},{\"type\":\"UPC\",\"value\":\"425261\"}],\"salesPrice\":{\"amount\":8.7,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"listPrice\":{\"amount\":10.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"manufacturerPrice\":{\"amount\":11.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"refPrice\":{\"refQuantity\":1,\"unit\":\"LITER\",\"quantity\":0.7