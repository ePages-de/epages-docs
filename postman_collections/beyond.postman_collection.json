      "body" : "{\"_embedded\":{\"products\":[{\"_id\":\"85b01a34-0ccc-47a4-8004-6fa09d940ebe\",\"sku\":\"vino020\",\"name\":\"Rødvin Rioja Castillo, år 2021\",\"manufacturer\":\"Grape Vineyard\",\"productIdentifiers\":[{\"type\":\"EAN\",\"value\":\"501234567890\"},{\"type\":\"UPC\",\"value\":\"425261\"}],\"salesPrice\":{\"amount\":8.7,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"listPrice\":{\"amount\":10.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"manufacturerPrice\":{\"amount\":11.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"refPrice\":{\"refQuantity\":1,\"unit\":\"LITER\",\"quantity\":0.75,\"price\":{\"amount\":11.6,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"}},\"shippingWeight\":{\"value\":1175.0,\"displayUnit\":\"GRAMS\"},\"shippingDimension\":{\"length\":1500,\"width\":1000,\"height\":2000},\"customText\":{\"label\":\"Tilføj modtagerens navn\",\"maxLength\":20},\"_embedded\":{\"defaultImage\":{\"dataUri\":\"https://yourshop.api.urn/storage-api/images/rioja-01.jpg?hash=e9a1ce5c0c6abfebec8fb1f6faf77dca7e6e7777{&width,height,upscale}\",\"width\":200,\"height\":300},\"availability\":{\"stockThreshold\":1,\"availableStock\":5,\"availabilityState\":\"IN_STOCK\",\"purchasable\":true}},\"productLabels\":[{\"type\":\"SALE\"},{\"type\":\"CUSTOMIZABLE\"}],\"type\":\"PRODUCT\",\"additionalDescriptions\":[{\"headline\":\"Om vingården\",\"htmlDescription\":\"<b>Drue-vingården</b><br>\\n<p>\\n  The Grape Vineyard er en af Spaniens mest berømte vingårde,\\n  især kendt for sin lækre rødvin.\\n  Selve vingården kan dateres tilbage til det 18. århundrede og\\n  og har været drevet af den samme familie i generationer.\\n</p>\\n\",\"_id\":\"769201e8-dbbb-40f1-8056-91fb3e07c708\"},{\"headline\":\"Om vinifikationen\",\"htmlDescription\":\"<p>\\n  At skabe denne lækre vin er en lang\\n  og delikat proces med mange trin.\\n</p>\\n<ol>\\n  <li>\\n    Druerne høstes, udvælges omhyggeligt,\\n    og forberedes til gæring.\\n  </li>\\n  <li>\\n    Efter gæringen lagres vinen i de fineste\\n    egetræskasser, som giver vinen dens unikke aroma.\\n  </li>\\n  <li>\\n    Efter at have gennemgået endnu en omhyggelig udvælgelsesproces,\\n    bliver vinen endelig tappet på flaske og er klar til at blive værdsat af vinelskere over hele verden.\\n  </li>\\n</ol>\\n\",\"_id\":\"574805ec-77a0-409f-87d0-3f00c058ddc3\"}],\"_links\":{\"self\":{\"href\":\"https://yourshop.api.urn/product-view/products/85b01a34-0ccc-47a4-8004-6fa09d940ebe\"},\"product\":{\"href\":\"https://yourshop.api.urn/product-view/products/85b01a34-0ccc-47a4-8004-6fa09d940ebe\"},\"cross-sells\":{\"href\":\"https://yourshop.api.urn/product-view/products/85b01a34-0ccc-47a4-8004-6fa09d940ebe/cross-sells\"}},\"_indexedAt\":\"2026-06-15T08:06:41\"},{\"_id\":\"f98f0bfc-7f04-4102-9e9e-9f8bb1ac0652\",\"sku\":\"vino020\",\"name\":\"Rødvin Rioja Castillo, år 2022\",\"manufacturer\":\"Grape Vineyard\",\"productIdentifiers\":[{\"type\":\"EAN\",\"value\":\"501234567890\"},{\"type\":\"UPC\",\"value\":\"425261\"}],\"salesPrice\":{\"amount\":8.7,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"listPrice\":{\"amount\":10.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"manufacturerPrice\":{\"amount\":11.95,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"},\"refPrice\":{\"refQuantity\":1,\"unit\":\"LITER\",\"quantity\":0.75,\"price\":{\"amount\":11.6,\"currency\":\"EUR\",\"taxModel\":\"GROSS\"}},\"shippingWeight\":{\"value\":1175.0,\"displayUnit\":\"GRAMS\"},\"shippingDimension\":{\"length\":1500,\"width\":1000,\"height\":2000},\"customText\":{\"label\":\"Tilføj modtagerens navn\",\"maxLength\":20},\"_embedded\":{\"defaultImage\":{\"dataUri\":\"https://yourshop.api.urn/storage-api/images/rioja-01.jpg?hash=e9a1ce5c0c6abfebec8fb1f6faf77dca7e6e7777{&width,height,upscale}\",\"width\":200,\"height\":300},\"availability\":{\"stockThreshold\":1,\"availableStock\":5,\"availabilityState\":\"IN_STOCK\",\"purchasable\":true}},\"productLabels\":[{\"type\":\"SALE\"},{\"type\":\"CUSTOMIZABLE\"}],\"type\":\"PRODUCT\",